# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===== Turso — required for the auth system =====
# After running `turso db create studio7-dashboard` and
# `turso db tokens create studio7-dashboard`, copy the values here.
VITE_TURSO_DATABASE_URL="libsql://your-database.turso.io"
VITE_TURSO_AUTH_TOKEN="your-turso-auth-token"

# Legacy Supabase (kept for backward compat with the old auth system —
# not used by the new Turso-based login).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
