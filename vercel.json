{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/uploads/:kind",
      "destination": "/api/uploads?kind=:kind"
    },
    {
      "source": "/api/cron/audit-cleanup",
      "destination": "/api/line-bot?route=cron/cleanup"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/audit-cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
