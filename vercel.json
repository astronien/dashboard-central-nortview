{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/uploads/:kind",
      "destination": "/api/uploads?kind=:kind"
    },
    {
      "source": "/api/line-webhook",
      "destination": "/api/health?line=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
